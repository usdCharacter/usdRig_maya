//Maya ASCII 2026 scene
requires maya "2026";
currentUnit -l centimeter -a degree -t film;
createNode transform -n "source1";
	setAttr ".t" -type "double3" 3 0 0 ;
	setAttr ".s" -type "double3" -1 1 1 ;
createNode transform -n "target";
createNode parentConstraint -n "target_parentConstraint1" -p "target";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "source1W0" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k off ".v";
	setAttr -k off ".tx";
	setAttr -k off ".ty";
	setAttr -k off ".tz";
	setAttr -k off ".rx";
	setAttr -k off ".ry";
	setAttr -k off ".rz";
	setAttr -k off ".sx";
	setAttr -k off ".sy";
	setAttr -k off ".sz";
	setAttr ".erp" yes;
	setAttr ".lr" -type "double3" 0 0 25 ;
	setAttr ".rst" -type "double3" 3 0 0 ;
	setAttr -k on ".w0";
createNode transform -n "mirroredParent";
	setAttr ".t" -type "double3" -2 0 0 ;
	setAttr ".s" -type "double3" -1 1 1 ;
createNode transform -n "child" -p "mirroredParent";
	setAttr ".t" -type "double3" 1 3 0 ;
	setAttr ".r" -type "double3" 0 0 10 ;
createNode transform -n "follower";
createNode parentConstraint -n "follower_parentConstraint1" -p "follower";
	addAttr -dcb 0 -ci true -k true -sn "w0" -ln "childW0" -dv 1 -min 0 -at "double";
	setAttr -k on ".nds";
	setAttr -k off ".v";
	setAttr -k off ".tx";
	setAttr -k off ".ty";
	setAttr -k off ".tz";
	setAttr -k off ".rx";
	setAttr -k off ".ry";
	setAttr -k off ".rz";
	setAttr -k off ".sx";
	setAttr -k off ".sy";
	setAttr -k off ".sz";
	setAttr ".erp" yes;
	setAttr ".lr" -type "double3" 180 1.2184387829091866e-15 -10 ;
	setAttr ".rst" -type "double3" -3 3 0 ;
	setAttr ".rsrr" -type "double3" 180 1.2184387829091866e-15 -10 ;
	setAttr -k on ".w0";
connectAttr "target_parentConstraint1.ctx" "target.tx";
connectAttr "target_parentConstraint1.cty" "target.ty";
connectAttr "target_parentConstraint1.ctz" "target.tz";
connectAttr "target_parentConstraint1.crx" "target.rx";
connectAttr "target_parentConstraint1.cry" "target.ry";
connectAttr "target_parentConstraint1.crz" "target.rz";
connectAttr "target.ro" "target_parentConstraint1.cro";
connectAttr "target.pim" "target_parentConstraint1.cpim";
connectAttr "target.rp" "target_parentConstraint1.crp";
connectAttr "target.rpt" "target_parentConstraint1.crt";
connectAttr "source1.t" "target_parentConstraint1.tg[0].tt";
connectAttr "source1.rp" "target_parentConstraint1.tg[0].trp";
connectAttr "source1.rpt" "target_parentConstraint1.tg[0].trt";
connectAttr "source1.r" "target_parentConstraint1.tg[0].tr";
connectAttr "source1.ro" "target_parentConstraint1.tg[0].tro";
connectAttr "source1.s" "target_parentConstraint1.tg[0].ts";
connectAttr "source1.pm" "target_parentConstraint1.tg[0].tpm";
connectAttr "target_parentConstraint1.w0" "target_parentConstraint1.tg[0].tw";
connectAttr "follower_parentConstraint1.ctx" "follower.tx";
connectAttr "follower_parentConstraint1.cty" "follower.ty";
connectAttr "follower_parentConstraint1.ctz" "follower.tz";
connectAttr "follower_parentConstraint1.crx" "follower.rx";
connectAttr "follower_parentConstraint1.cry" "follower.ry";
connectAttr "follower_parentConstraint1.crz" "follower.rz";
connectAttr "follower.ro" "follower_parentConstraint1.cro";
connectAttr "follower.pim" "follower_parentConstraint1.cpim";
connectAttr "follower.rp" "follower_parentConstraint1.crp";
connectAttr "follower.rpt" "follower_parentConstraint1.crt";
connectAttr "child.t" "follower_parentConstraint1.tg[0].tt";
connectAttr "child.rp" "follower_parentConstraint1.tg[0].trp";
connectAttr "child.rpt" "follower_parentConstraint1.tg[0].trt";
connectAttr "child.r" "follower_parentConstraint1.tg[0].tr";
connectAttr "child.ro" "follower_parentConstraint1.tg[0].tro";
connectAttr "child.s" "follower_parentConstraint1.tg[0].ts";
connectAttr "child.pm" "follower_parentConstraint1.tg[0].tpm";
connectAttr "follower_parentConstraint1.w0" "follower_parentConstraint1.tg[0].tw"
		;
